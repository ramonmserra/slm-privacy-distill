# Copie para `.env` e preencha. O `.env` e' ignorado pelo git; TODO parametro
# do projeto (chaves, modelos, orcamento, caminhos) mora aqui, nunca no codigo.
#   copy .env.example .env      (PowerShell)

# ----------------------------------------------------------------------------
# OBRIGATORIO
# ----------------------------------------------------------------------------
# test | development | production. `AUTH_MODE=disabled` so' e' aceito em `test`.
APP_ENV=development

# api_key | disabled. Sem esta variavel a API recusa tudo com 503.
AUTH_MODE=api_key
# Chaves aceitas no header X-API-Key, separadas por virgula; opcionalmente
# `chave:nome` para a auditoria saber quem chamou. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_API_KEYS=troque-esta-chave:ramon

# Chave do provedor do PROFESSOR (OpenAI).
OPENAI_API_KEY=sk-...

# ----------------------------------------------------------------------------
# PAPEIS DE MODELO -- qual provedor e qual modelo atende cada papel
# (ver app/core/llm.py). O codigo pede o PAPEL; o nome do modelo vem daqui.
# ----------------------------------------------------------------------------
# Professor: gera os dados sinteticos e as cadeias de raciocinio.
TEACHER_PROVIDER=openai
OPENAI_MODEL_TEACHER=gpt-5.6-luna

# Juiz: avalia professor e aluno. REGRA DA PESQUISA: familia diferente do
# professor (juiz igual ao professor tem vies de autopreferencia). A API avisa
# em GET /usage/providers quando os dois coincidem.
JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_JUDGE=claude-sonnet-5

# Aluno: o SLM local servido por um endpoint OpenAI-compatible (Ollama ou vLLM).
STUDENT_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_STUDENT=qwen3:1.7b
# Alguns servidores exigem um token qualquer no header Authorization.
LOCAL_LLM_API_KEY=ollama

# ----------------------------------------------------------------------------
# CUSTO E LIMITES
# ----------------------------------------------------------------------------
# Teto de custo estimado (USD) por JOB de LLM. O job e' recusado antes da
# chamada que o estouraria. 0 desliga o teto.
LLM_BUDGET_USD_POR_JOB=5.0
# Timeout de UMA chamada (s) e retries do SDK por erro de rede/429.
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# Falhas de saturacao seguidas que abrem o disjuntor e tempo (s) que ele fica aberto.
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_S=30
# Sobrescreve/adiciona precos (USD por 1M tokens):
#   LLM_PRICING_JSON={"openai:gpt-5.6-luna": {"input": 0.20, "output": 1.20}}
# LLM_PRICING_JSON=

# ----------------------------------------------------------------------------
# INFRA
# ----------------------------------------------------------------------------
# Onde ficam datasets, telemetria e artefatos (fora do git).
DATA_DIR=data
# text | json (uma linha JSON por evento, com request_id)
LOG_FORMAT=text
